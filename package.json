{
  "name": "hathor",
  "private": true,
  "version": "0.142.0",
  "type": "module",
  "scripts": {
    "predev": "run-p copy:theme copy:config && node scripts/local-nationale-setup.mjs --link",
    "dev": "vite",
    "prelocal": "run-p copy:theme copy:config-local && node scripts/local-nationale-setup.mjs --link",
    "local": "vite",
    "build": "tsc -b && vite build",
    "local-nationale-setup": "node scripts/local-nationale-setup.mjs",
    "copy:theme": "ncp .github/environments/theme-localhost.json public/theme-dev.json",
    "copy:config-local": "ncp .github/environments/config-localhost.json public/config.json",
    "copy:config": "ncp .github/environments/config-dev.json public/config.json",
    "lint": "eslint .",
    "check": "prettier . --check",
    "format": "prettier --write .",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "test:coverage": "vitest run --coverage --project=unit",
    "test:stories": "vitest run --project=storybook",
    "e2e": "npx playwright test",
    "e2e:local-backend": "E2E_BACKEND=true npx playwright test --workers=1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@entur/iteru-3dbus": "^0.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/utils": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@opentrainticketing/netex-deckplan-editor": "^2.0.5",
    "@types/papaparse": "^5.5.2",
    "fast-xml-parser": "~5.12.1",
    "graphql": "^16.11.0",
    "graphql-request": "^7.3.1",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "npm-run-all": "^4.1.5",
    "oidc-client-ts": "^3.2.1",
    "papaparse": "^5.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^7.18.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.12",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.0.0",
    "ncp": "^2.0.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "storybook": "^10.6.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@vitest/mocker": "4.1.11",
    "@vitest/browser": "4.1.11"
  }
}
