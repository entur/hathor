# npm 12 changed allow-remote's default to "none", which refuses any dependency
# resolving to a tarball URL rather than a registry version/semver range. That
# makes `npm ci` fail outright (EALLOWREMOTE) on @entur/mui-comps-nmr, which we
# consume as a GitHub release asset — a host unrelated to the registry, so the
# same-host exemption does not cover it.
#
# "root" allows URL deps at the root of our own tree (ones we add deliberately)
# while still refusing URL tarballs pulled in transitively by other packages.
# Prefer it over "all", which would permit both.
allow-remote=root
