# Custom scalars
scalar DateTime
scalar Date

# MultilingualString type
type MultilingualString {
    value: String
    lang: String
}

input MultilingualStringInput {
    value: String
    lang: String
}

input VehicleTypeReferenceInput {
    netexId: String!
}

input DeckPlanReferenceInput {
    netexId: String!
}

input DeactivateInput {
    netexId: String!
    version: Int!
    deactivateAt: DateTime!
}

# Enums
enum FareClass {
    UNKNOWN
    FIRST_CLASS
    SECOND_CLASS
    THIRD_CLASS
    PREFERENTE
    PREMIUM_CLASS
    BUSINESS_CLASS
    STANDARD_CLASS
    TURISTA
    ECONOMY_CLASS
    ANY
}

enum TransportMode {
    ALL
    AIR
    ANY_MODE
    BUS
    CABLEWAY
    COACH
    FERRY
    FUNICULAR
    INTERCITY_RAIL
    LIFT
    METRO
    OTHER
    RAIL
    SELF_DRIVE
    SNOW_AND_ICE
    TAXI
    TRAM
    TROLLEY_BUS
    UNKNOWN
    URBAN_RAIL
    WATER
}

enum OrganisationType {
    AUTHORITY
    OPERATOR
    OTHER
}

enum PropulsionType {
    COMBUSTION
    ELECTRIC
    ELECTRIC_ASSIST
    HYBRID
    HUMAN
    OTHER
}

enum FuelType {
    PETROL
    PETROL_LEADED
    PETROL_UNLEADED
    DIESEL
    ELECTRICITY
    BATTERY
    ELECTRIC_CONTACT
    DIESEL_BATTERY_HYBRID
    PETROL_BATTERY_HYBRID
    HYDROGEN
    BIODIESEL
    NATURAL_GAS
    LIQUID_GAS
    METHANE
    TPG
    ETHANOL
    OTHER
    NONE
}

enum HybridCategory {
    CHARGEABLE
    NONCHARGEABLE
}

enum VehicleTypeKind {
    PHYSICAL
    CONTRACTUAL
}

enum VehicleTypeSubtype {
    "A vehicle type that is none of the ones below"
    VEHICLE_TYPE
    "A train: a vehicle type made of components, each a reference to a train element"
    TRAIN
    "A compound train: a vehicle type made of trains"
    COMPOUND_TRAIN
    "A train element: a single car or engine that trains are made of"
    TRAIN_ELEMENT
}

enum TrainElementType {
    BUFFET_CAR
    CARRIAGE
    ENGINE
    CAR_TRANSPORTER
    LARGE_VEHICLE_TRANSPORTER
    SLEEPER_CARRIAGE
    LUGGAGE_VAN
    RESTAURANT_CARRIAGE
    OTHER
}

enum TrainSize {
    NORMAL
    SHORT
    LONG
}

enum VehicleOrientation {
    FORWARDS
    BACKWARDS
    UNKNOWN
}

enum ThroughAccess {
    NO_THROUGH_ACCESS
    OPEN_ENTRANCE
    DOOR
    UNKNOWN
}

# Filter inputs
input VehicleTypeFilter {
    netexIds: [String!]
    transportModes: [TransportMode!]
    vehicleTypeKind: VehicleTypeKind!
    "Only vehicle types of this subtype. Omit to get all subtypes."
    subtype: VehicleTypeSubtype
    name: String
    dataOwnerRef: String!
}

input VehicleFilter {
    netexIds: [String!]
    transportModes: [TransportMode!]
    name: String
    dataOwnerRef: String!
}

input OrganisationsFilter {
    netexIds: [String!]
    name: String
    onlyUserAuthorized: Boolean
}

input CodeValuesFilter {
    valueType: String!
}

input DeckPlanFilter {
    netexIds: [String!]
    transportModes: [TransportMode!]
    name: String
    dataOwnerRef: String!
}

# Page types
type Page {
    page: Int!
    size: Int!
    totalElements: Int!
}

# KeyValues type
type KeyValues {
    key: String!
    value: String!
}
input KeyValuesInput {
    key: String!
    value: String!
}

# PrivateCode type
type PrivateCode {
    type: String
    value: String!
}

input PrivateCodeInput {
    type: String
    value: String!
}

# PassengerCapacity type
type PassengerCapacity {
    fareClass: FareClass
    specialPlaceCapacity: Int
    totalCapacity: Int
    seatingCapacity: Int
    standingCapacity: Int
    pushchairCapacity: Int
    wheelchairPlaceCapacity: Int
    pramPlaceCapacity: Int
    bicycleRackCapacity: Int
}
input PassengerCapacityInput {
    fareClass: FareClass
    specialPlaceCapacity: Int
    totalCapacity: Int
    seatingCapacity: Int
    standingCapacity: Int
    pushchairCapacity: Int
    wheelchairPlaceCapacity: Int
    pramPlaceCapacity: Int
    bicycleRackCapacity: Int
}

# DeckPlan type
type DeckPlan {
    dataOwnerRef: String!
    netexId: String!
    name: MultilingualString
    description: MultilingualString
    version: String
    created: DateTime
    changed: DateTime
}
input DeckPlanInput {
    netexId: String
    name: MultilingualStringInput
    description: MultilingualStringInput
    dataOwnerRef: String!
}

type DeckPlanPage {
    content: [DeckPlan!]!
    totalElements: Int!
    page: Int!
    size: Int!
}

# Organisation type
type Organisation {
    netexId: String!
    name: MultilingualString
    type: OrganisationType
}

type OrganisationPage {
    content: [Organisation!]!
    totalElements: Int!
    page: Int!
    size: Int!
}

# Code value
type CodeValue {
    valueType: String!
    label: String!
    value: String!
}

type CodeValuePage {
    content: [CodeValue!]!
    totalElements: Int!
    page: Int!
    size: Int!
}

# Vehicle
type Vehicle {
    dataOwnerRef: String!
    netexId: String!
    name: MultilingualString
    description: MultilingualString
    registrationNumber: String
    operationalNumber: String
    transportType: VehicleType
    chassisNumber: String
    buildDate: Date
    registrationDate: Date
    version: String
    created: DateTime
    changed: DateTime
    changedBy: String
}

input VehicleInput {
    netexId: String
    name: MultilingualStringInput
    description: MultilingualStringInput
    registrationNumber: String
    operationalNumber: String
    transportType: VehicleTypeReferenceInput
    chassisNumber: String
    buildDate: Date
    registrationDate: Date
    dataOwnerRef: String!
}

type VehiclePage {
    content: [Vehicle!]!
    totalElements: Int!
    page: Int!
    size: Int!
}

# A component of a train: a train element in a position. The position is the place in the list.
type TrainComponent {
    netexId: String
    label: MultilingualString
    description: MultilingualString
    "The train element that is in this position"
    trainElement: VehicleType
    operationalOrientation: VehicleOrientation
    forwardCouplingThroughAccess: ThroughAccess
}

input TrainComponentInput {
    "Leave out to get an id assigned. An id in your own codespace is kept."
    netexId: String
    label: MultilingualStringInput
    description: MultilingualStringInput
    "The train element, which must have the same data owner as the train"
    trainElement: VehicleTypeReferenceInput!
    operationalOrientation: VehicleOrientation
    forwardCouplingThroughAccess: ThroughAccess
}

# A component of a compound train: a train in a position. The position is the place in the list.
type TrainInCompoundTrain {
    netexId: String
    label: MultilingualString
    description: MultilingualString
    train: VehicleType
    operationalOrientation: VehicleOrientation
}

input TrainInCompoundTrainInput {
    "Leave out to get an id assigned. An id in your own codespace is kept."
    netexId: String
    label: MultilingualStringInput
    description: MultilingualStringInput
    "The train, which must have the same data owner as the compound train"
    train: VehicleTypeReferenceInput!
    operationalOrientation: VehicleOrientation
}

type VehicleType {
    dataOwnerRef: String!
    subtype: VehicleTypeSubtype!
    "Only for trains"
    numberOfCars: Int
    "Only for trains"
    trainSizeType: TrainSize
    "Only for trains, in order"
    trainComponents: [TrainComponent!]
    "Only for compound trains, in order"
    compoundTrainComponents: [TrainInCompoundTrain!]
    "Only for train elements"
    trainElementType: TrainElementType
    netexId: String!
    name: MultilingualString
    shortName: MultilingualString
    description: MultilingualString
    euroClass: String
    propulsionTypes: [PropulsionType]
    fuelTypes: [FuelType]
    transportMode: TransportMode
    passengerCapacity: PassengerCapacity
    privateCode: PrivateCode
    keyValues: [KeyValues!]
    deckPlan: DeckPlan
    vehicles: [Vehicle!]
    formDragCoefficient: Float
    rollResistanceCoefficient: Float
    maximumEngineEffectKW: Float
    maximumVelocity: Float
    maximumRange: Float
    length: Float
    height: Float
    width: Float
    weight: Float
    lowFloor: Boolean
    selfPropelled: Boolean
    hybridCategory: HybridCategory
    vehicleTypeKind: VehicleTypeKind!
    version: String
    created: DateTime
    changed: DateTime
    changedBy: String
}

input VehicleTypeInput {
    netexId: String
    "Fixed when the vehicle type is created. Omitted means VEHICLE_TYPE, so it must be repeated when updating a train or a compound train."
    subtype: VehicleTypeSubtype
    "Only for trains"
    numberOfCars: Int
    "Only for trains"
    trainSizeType: TrainSize
    "Only for trains. The list replaces the components of the previous version."
    trainComponents: [TrainComponentInput!]
    "Only for compound trains. The list replaces the components of the previous version."
    compoundTrainComponents: [TrainInCompoundTrainInput!]
    "Only for train elements"
    trainElementType: TrainElementType
    name: MultilingualStringInput
    shortName: MultilingualStringInput
    description: MultilingualStringInput
    euroClass: String
    propulsionTypes: [PropulsionType]
    fuelTypes: [FuelType]
    transportMode: TransportMode
    passengerCapacity: PassengerCapacityInput
    privateCode: PrivateCodeInput
    keyValues: [KeyValuesInput!]
    deckPlan: DeckPlanReferenceInput
    formDragCoefficient: Float
    rollResistanceCoefficient: Float
    maximumEngineEffectKW: Float
    maximumVelocity: Float
    maximumRange: Float
    length: Float
    height: Float
    width: Float
    weight: Float
    lowFloor: Boolean
    selfPropelled: Boolean
    hybridCategory: HybridCategory
    "Required when creating a vehicle type (no netexId, or a netexId that does not exist yet). Fixed after creation: omit it when updating, or repeat the existing value."
    vehicleTypeKind: VehicleTypeKind
    dataOwnerRef: String!
}

type VehicleTypePage {
    content: [VehicleType!]!
    totalElements: Int!
    page: Int!
    size: Int!
}

# Root query type
type Query {
    vehicles(filter: VehicleFilter, page: Int = 0, size: Int = 20): VehiclePage!
    vehicleTypes(filter: VehicleTypeFilter, page: Int = 0, size: Int = 20): VehicleTypePage!
    deckPlans(filter: DeckPlanFilter, page: Int = 0, size: Int = 20): DeckPlanPage!
    organisations(filter: OrganisationsFilter, page: Int = 0, size: Int = 20): OrganisationPage!
    codeValues(filter: CodeValuesFilter!, page: Int = 0, size: Int = 20): CodeValuePage!
}

type Mutation {
    createOrUpdateVehicle(input: VehicleInput!): String
    createOrUpdateVehicleType(input: VehicleTypeInput!): String
    createOrUpdateDeckPlan(input: DeckPlanInput!): String

    deactivateVehicle(input: DeactivateInput!): Vehicle
    deactivateVehicleType(input: DeactivateInput!): VehicleType
    deactivateDeckPlan(input: DeactivateInput!): DeckPlan
}

schema {
    query: Query
    mutation: Mutation
}